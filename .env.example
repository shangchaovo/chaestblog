PORT=8777
HUB_ADMIN_TOKEN=change-me

# 本机直连 Magpie；密钥只放 .env，不能提交。
# MAGPIE_BASE_URL=http://your-private-magpie:3425/v1
# MAGPIE_API_KEY=your-magpie-key

# 私网中转的独立随机口令，至少 32 字符；与 Pages Secret 保持一致。
# ASSISTANT_RELAY_TOKEN=your-random-relay-token
# ASSISTANT_RELAY_PORT=8778

# Pages 使用完整 HTTPS /chat 地址与上面的独立口令。
# 本机直连时留空；设置后优先使用中转。
# ASSISTANT_RELAY_URL=https://your-bridge.example/chat
